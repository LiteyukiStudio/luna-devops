# Luna DevOps uses this single file for local development and Docker Compose
# interpolation. Copy it to `.env`; process environment variables still take
# precedence. Set ENV_FILE only when you intentionally want another file.
APP_ENV=development
# Development only: grant this many credits once to the local administrator.
# Set to 0 to create the wallet without granting free quota.
LOCAL_ADMIN_FREE_QUOTA_CREDITS=1000
API_ADDR=:8080
LOG_LEVEL=debug
SECRET_ENCRYPTION_KEY=
DATABASE_URL=postgres://devops:devops@localhost:5432/devops?sslmode=disable
REDIS_ADDR=redis://localhost:6379/0
PUBLIC_BASE_URL=http://localhost:5173
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The optional Prometheus compatibility endpoint belongs to API only and uses
# a dedicated listener. Worker and Agent metrics use OTLP instead.
METRICS_ENABLED=false
METRICS_ADDR=:9090
METRICS_PATH=/metrics

# Send traces, metrics and structured logs to an OpenTelemetry Collector.
# Leave the endpoint empty to keep telemetry exporters disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
# Optional authenticated Collector headers, for example: api-key=replace-me
OTEL_EXPORTER_OTLP_HEADERS=
# Agent only. Captures redacted model and tool content in traces and logs.
# Keep disabled except during a controlled diagnostic window.
AI_OBSERVABILITY_CAPTURE_CONTENT=false
# Agent only. Automatic PostgreSQL query spans are noisy and disabled by default.
# Enable temporarily when a diagnosis needs individual SQL timings.
AI_OBSERVABILITY_CAPTURE_DATABASE_SPANS=false

# Database pool and startup retry settings shared by API and Worker.
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Build and deployment defaults. Build jobs run in the Kubernetes cluster
# selected by the deployment target.
BUILD_EXECUTOR_IMAGE=moby/buildkit:v0.24.0-rootless
BUILD_EGRESS_MODE=restricted
BUILD_JOB_TIMEOUT_SECONDS=1800
BUILD_JOB_TTL_SECONDS=3600
BUILD_CACHE_ENABLED=false
BUILD_CACHE_TAG=buildcache
BUILD_NPM_REGISTRY=
BUILD_PRIVATE_EGRESS_CIDRS=
BUILD_PRIVATE_EGRESS_PORTS=443
BUILD_BLOCKED_EGRESS_CIDRS=
DEPLOY_ROLLOUT_TIMEOUT_SECONDS=600
CERT_MANAGER_CLUSTER_ISSUER=letsencrypt-http01

# Optional project-volume import/export. Leave VOLUME_TRANSFER_STORE empty to
# keep transfers disabled while volume creation, mounting and deletion remain
# available. API and Worker must receive the same S3 settings; the callback URL
# must be an HTTPS API address reachable from runtime clusters.
VOLUME_TRANSFER_STORE=
VOLUME_TRANSFER_S3_ENDPOINT=
VOLUME_TRANSFER_S3_REGION=us-east-1
VOLUME_TRANSFER_S3_BUCKET=
VOLUME_TRANSFER_S3_ACCESS_KEY_ID=
VOLUME_TRANSFER_S3_SECRET_ACCESS_KEY=
VOLUME_TRANSFER_S3_PATH_STYLE=true
VOLUME_TRANSFER_OBJECT_TTL=24h
VOLUME_TRANSFER_MAX_BYTES=100Gi
VOLUME_TRANSFER_SPOOL_DIR=/tmp/luna-devops-volume-transfer-spool
VOLUME_TRANSFER_SPOOL_MAX_BYTES=2Gi
VOLUME_TRANSFER_SPOOL_MIN_FREE_BYTES=1Gi
VOLUME_TRANSFER_SPOOL_ORPHAN_AGE=24h
VOLUME_TRANSFER_CALLBACK_BASE_URL=
VOLUME_TRANSFER_JOB_IMAGE=

# Embedded AI assistant BFF. Generate one stable internal root with:
# openssl rand -hex 32
AI_ASSISTANT_AVAILABLE=false
AI_AGENT_BASE_URL=
AI_INTERNAL_SECRET=

# Trust forwarded client IP headers only from these reverse proxy networks.
# Leave empty when the API is directly exposed.
TRUSTED_PROXY_CIDRS=

# Frontend build-time links.
# VITE_DOCS_BASE_URL=https://luna-devops.liteyuki.org

# Production Compose reads these values from the same `.env` file. Replace all
# placeholders before `docker compose up`; the Compose services themselves set
# APP_ENV=production and container-internal database/Redis addresses.
BOOTSTRAP_TOKEN=replace-with-a-strong-one-time-token
REDIS_PASSWORD=replace-with-a-url-safe-random-password
# For production, replace the empty development value above with a stable key:
# SECRET_ENCRYPTION_KEY=replace-with-64-hex-characters
