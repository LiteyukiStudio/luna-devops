NODE_ENV=development
HOST=127.0.0.1
PORT=8091

# 仅在设置端点后启用 OpenTelemetry；Agent 会向该 OTLP/HTTP 端点发送 Trace、Metrics 和 Logs。
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
OTEL_EXPORTER_OTLP_HEADERS=
# 高敏诊断开关：记录脱敏后的模型输入输出、工具参数与结果，默认关闭。
AI_OBSERVABILITY_CAPTURE_CONTENT=false
# PostgreSQL 自动查询 Span 默认关闭；仅在需要逐条 SQL 耗时诊断时临时开启。
AI_OBSERVABILITY_CAPTURE_DATABASE_SPANS=false

# 本地直连 Provider；三项需要同时填写。
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_MODEL=
