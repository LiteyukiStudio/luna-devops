NODE_ENV=development
HOST=127.0.0.1
PORT=8091
LOG_FORMAT=auto
LOG_COLOR=auto
LOG_LEVEL=debug

# 宿主机本地联调默认先读取根目录 .env；仅需覆盖的 Agent 专属值写入本目录 .env.local。
DATABASE_URL=postgres://devops:devops@localhost:5432/devops?sslmode=disable
AI_DATABASE_MAX_CONNECTIONS=10
AI_DATABASE_CONNECTION_TIMEOUT_MS=5000
AI_DATABASE_STATEMENT_TIMEOUT_MS=15000
AUTH_MODE=bff-hmac
AI_INTERNAL_SECRET=
LUNA_API_BASE_URL=http://localhost:8080

# 仅在设置端点后启用 OpenTelemetry；Agent 会向该 OTLP/HTTP 端点发送 Trace、Metrics 和 Logs。
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
OTEL_EXPORTER_OTLP_HEADERS=
# 高敏诊断开关：仅在受控 Trace 中记录脱敏后的模型与工具内容；日志只保留元数据。
AI_OBSERVABILITY_CAPTURE_CONTENT=false
# PostgreSQL 自动查询 Span 默认关闭；仅在需要逐条 SQL 耗时诊断时临时开启。
AI_OBSERVABILITY_CAPTURE_DATABASE_SPANS=false
