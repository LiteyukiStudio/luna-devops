{
  "id": "gitea",
  "slug": "gitea",
  "name": "Gitea",
  "description": "Lightweight self-hosted Git service for repositories, issues, and releases.",
  "category": "developerTool",
  "icon": "/app-templates/icons/gitea.svg",
  "officialWebsite": "https://about.gitea.com/",
  "officialRepository": "https://github.com/go-gitea/gitea",
  "popularityWeight": 82,
  "featured": true,
  "image": "gitea/gitea:28.4-rootless",
  "version": "28.4-rootless",
  "servicePort": 3000,
  "defaultReplicas": 1,
  "defaultCPU": "1",
  "defaultMemory": "1Gi",
  "fsGroup": "1000",
  "dataVolumes": [
    {
      "logicalName": "data",
      "sourceType": "projectVolume",
      "mountPath": "/var/lib/gitea"
    }
  ],
  "env": {
    "GITEA__database__DB_TYPE": "sqlite3",
    "GITEA__server__HTTP_PORT": "3000"
  },
  "values": []
}
