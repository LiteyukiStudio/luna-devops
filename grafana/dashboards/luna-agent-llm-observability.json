        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(luna_devops_agent_runs_total{outcome=~\"completed|succeeded\"}[$__rate_interval])) / clamp_min(sum(rate(luna_devops_agent_runs_total[$__rate_interval])), 0.001)",
