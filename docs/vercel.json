{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/guide/deployment/kubernetes-helm",
      "destination": "/start/install/kubernetes",
      "permanent": true
    },
    {
      "source": "/guide/deployment/docker-compose",
      "destination": "/start/install/docker-compose",
      "permanent": true
    },
    {
      "source": "/guide/workspace",
      "destination": "/start/connect-resources",
      "permanent": true
    },
    {
      "source": "/operations/diagnostics",
      "destination": "/use/diagnostics",
      "permanent": true
    },
    {
      "source": "/developer/architecture",
      "destination": "/reference/compatibility",
      "permanent": true
    },
    {
      "source": "/develop/external-compatibility",
      "destination": "/reference/compatibility",
      "permanent": true
    },
    {
      "source": "/changelog/cli",
      "destination": "https://github.com/LiteyukiStudio/luna-cli/releases",
      "permanent": true
    },
    {
      "source": "/en/guide/deployment/kubernetes-helm",
      "destination": "/en/start/install/kubernetes",
      "permanent": true
    },
    {
      "source": "/en/guide/deployment/docker-compose",
      "destination": "/en/start/install/docker-compose",
      "permanent": true
    },
    {
      "source": "/en/guide/workspace",
      "destination": "/en/start/connect-resources",
      "permanent": true
    },
    {
      "source": "/en/operations/diagnostics",
      "destination": "/en/use/diagnostics",
      "permanent": true
    },
    {
      "source": "/en/developer/architecture",
      "destination": "/en/reference/compatibility",
      "permanent": true
    },
    {
      "source": "/en/develop/external-compatibility",
      "destination": "/en/reference/compatibility",
      "permanent": true
    },
    {
      "source": "/en/changelog/cli",
      "destination": "https://github.com/LiteyukiStudio/luna-cli/releases",
      "permanent": true
    }
  ]
}
