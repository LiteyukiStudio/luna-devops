# Luna DevOps uses this single file for local development and Docker Compose.
# Copy it to `.env`; process environment variables still take precedence. Each
# Compose service receives only the variables it consumes. Set ENV_FILE only
# when a manually started process must read another file.
APP_ENV=development
# API only. These values create the first administrator when the database has
# no users. The password must contain 8 to 72 bytes; no default is provided.
# An empty name falls back to the email; language must be zh-CN or en-US.
# Email and password may remain empty when an active administrator exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_LANGUAGE=zh-CN
# Development only: grant this many credits once to the local administrator.
# Set to 0 to create the wallet without granting free quota.
LOCAL_ADMIN_FREE_QUOTA_CREDITS=1000
API_ADDR=:8080
# API, Worker, and Agent share these logging defaults. auto renders a readable
# console on an interactive terminal and JSON elsewhere.
LOG_FORMAT=auto
LOG_COLOR=auto
LOG_LEVEL=info
# API and Worker share the platform encryption key and Redis connection. All
# three services connect to PostgreSQL, with separate pool budgets below.
SECRET_ENCRYPTION_KEY=
DATABASE_URL=postgres://devops:devops@localhost:5432/devops?sslmode=disable
REDIS_ADDR=redis://localhost:6379/0
# API and Worker share one public address for callbacks, webhooks, and
# notification links. API and Worker require it in production. CORS and trusted
# proxy settings remain API-only.
PUBLIC_BASE_URL=http://localhost:5173
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXY_CIDRS=

# The optional Prometheus compatibility endpoint belongs to API only and uses
# a dedicated listener. Worker and Agent metrics use OTLP instead.
METRICS_ENABLED=false
METRICS_ADDR=:9090
METRICS_PATH=/metrics

# Send traces, metrics and structured logs to an OpenTelemetry Collector.
# Leave the endpoint empty to keep telemetry exporters disabled. When enabled,
# set resource attributes for the actual environment instead of copying labels.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=
# Optional authenticated Collector headers, for example: api-key=replace-me
OTEL_EXPORTER_OTLP_HEADERS=
# API-only overrides for the browser Trace relay. Empty values reuse the common
# OTLP endpoint and headers above.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# Agent only. Captures redacted model and tool content in controlled traces; logs keep metadata only.
# Keep disabled except during a controlled diagnostic window.
AI_OBSERVABILITY_CAPTURE_CONTENT=false
# Agent only. Automatic PostgreSQL query spans are noisy and disabled by default.
# Enable temporarily when a diagnosis needs individual SQL timings.
AI_OBSERVABILITY_CAPTURE_DATABASE_SPANS=false

# Agent-only PostgreSQL pool guards. Size this per Agent replica and keep the
# sum of API, Worker, Agent, migration, and operator connections below the
# PostgreSQL server budget.
AI_DATABASE_MAX_CONNECTIONS=10
AI_DATABASE_CONNECTION_TIMEOUT_MS=5000
AI_DATABASE_STATEMENT_TIMEOUT_MS=15000

# API and Worker use separate PostgreSQL connection budgets. The Agent keeps
# its AI_DATABASE_* pool settings above.
API_DB_MAX_OPEN_CONNS=20
API_DB_MAX_IDLE_CONNS=5
API_DB_CONN_MAX_LIFETIME=30m
API_DB_CONN_MAX_IDLE_TIME=5m
WORKER_DB_MAX_OPEN_CONNS=20
WORKER_DB_MAX_IDLE_CONNS=5
WORKER_DB_CONN_MAX_LIFETIME=30m
WORKER_DB_CONN_MAX_IDLE_TIME=5m

# Build and deployment defaults. Build jobs run in the Kubernetes cluster
# selected by the deployment target.
BUILD_EXECUTOR_IMAGE=moby/buildkit:v0.24.0-rootless
BUILD_EGRESS_MODE=restricted
BUILD_JOB_TIMEOUT_SECONDS=1800
BUILD_JOB_TTL_SECONDS=3600
BUILD_CACHE_ENABLED=false
BUILD_CACHE_TAG=buildcache
BUILD_PRIVATE_EGRESS_CIDRS=
BUILD_PRIVATE_EGRESS_PORTS=443
BUILD_BLOCKED_EGRESS_CIDRS=
DEPLOY_ROLLOUT_TIMEOUT_SECONDS=600
CERT_MANAGER_CLUSTER_ISSUER=letsencrypt-http01

# Project-volume import/export streams directly through a temporary transfer
# workload in the runtime cluster. The image must match the Worker version.
VOLUME_TRANSFER_MAX_BYTES=100Gi
VOLUME_TRANSFER_JOB_IMAGE=

# Embedded AI assistant BFF. Generate one stable internal root with:
# openssl rand -hex 32
AI_ASSISTANT_AVAILABLE=false
# Source development uses these two loopback addresses. Production Compose pins
# both directions to container-internal service addresses instead.
AI_AGENT_BASE_URL=http://localhost:8091
# Bounded timeout for non-streaming API-to-Agent calls; SSE stays unbounded.
AI_AGENT_TIMEOUT=10s
AI_INTERNAL_SECRET=
# Agent only. Local API access uses the same HMAC root above.
AUTH_MODE=bff-hmac
LUNA_API_BASE_URL=http://localhost:8080

# Frontend build-time links.
# VITE_DOCS_BASE_URL=https://luna-devops.liteyuki.org

# Production Compose forwards every setting through an explicit consumer
# allowlist. For a fresh database, fill the initial administrator fields above
# before `docker compose up`; Compose fixes the runtime mode to production and
# injects container-internal database/Redis addresses.
DEVOPS_IMAGE_TAG=nightly
REDIS_PASSWORD=replace-with-a-url-safe-random-password
# For production, replace the empty development value above with a stable key:
# SECRET_ENCRYPTION_KEY=replace-with-64-hex-characters
