NODE_ENV=development
HOST=127.0.0.1
PORT=8091

# 仅在设置端点后启用 OpenTelemetry；Agent 会向该 OTLP/HTTP 端点发送 Trace、Metrics 和 Logs。
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
OTEL_EXPORTER_OTLP_HEADERS=

# 本地直连 Provider；三项需要同时填写。
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_MODEL=
